# Quadlet: systemd generates searxng.service from this at daemon-reload.
# Deliberately no [Install] section -- vibecontrol's search toggle starts and
# stops it, so it should not come up on its own.
[Unit]
Description=SearXNG metasearch, local agent backend

[Container]
Image=docker.io/searxng/searxng:latest
# Host side is loopback only: the hotspot carries other devices and this has no
# authentication of its own.
PublishPort=127.0.0.1:8888:8080
Volume=%h/.config/searxng:/etc/searxng:Z,ro
Environment=SEARXNG_BASE_URL=http://127.0.0.1:8888/

[Service]
Restart=on-failure
TimeoutStartSec=90
