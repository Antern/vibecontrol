category="common"
label="Local LLM"
group="llm"
section="local ai"
# A 27B takes a while to page onto the card, and the toggle does not report
# success until the server actually answers. force rather than rollback: if it
# will not come up, the half-started unit should go away, not be restarted.
timeout=120
on_timeout=force
# Started last in a preset. headless-ai frees the GPU by switching the desktop
# off; loading 12 GB of weights while the desktop still holds its GB is how you
# get an out-of-memory instead of a speed-up.
defer_on=1
_unit="vibecontrol-llm"

# Nothing about the model is hardcoded. These live in ~/.config/vibecontrol/config
# so another machine, or another quant, needs no edit here:
#
#   llm.model   = ~/models/Qwen3.8-27B-UD-Q3_K_XL.gguf
#   llm.host    = <hotspot-ip>        (hotspot only; 127.0.0.1 to keep it local)
#   llm.port    = 8080
#   llm.ctx     = 16384
#   llm.keyfile = ~/.config/vibecontrol/llm.key   (optional)
#   llm.think   = 0 | 1            (default 0)
#   llm.alias   = local            (name clients use; default "local")
#   llm.mcp_config = /path/to/mcp.json         (optional)
#   llm.cors_origins = http://<hotspot-ip>:8080   (optional)
#   llm.bin          = path to llama-server    (default: the Vulkan build)
#   llm.device       = Vulkan0 | ROCm0         (default Vulkan0)
#   llm.cache_type_k = q8_0 | q5_1 | q4_0      (default q8_0)
#   llm.cache_type_v = q8_0 | q5_1 | q4_0      (default q8_0)
#   llm.spec_type    = draft-mtp               (optional, needs an -mtp GGUF)
#   llm.spec_draft_n_max = 2                   (optional)
#
# llm.mcp_config gives the server tools. llama-server spawns each declared MCP
# server itself, as a child process speaking JSON-RPC on stdio -- the only
# transport it supports -- lists its tools once at startup and respawns it on
# demand when a tool is called. They then appear as <server>_<tool> in the web
# UI and in GET /tools, for every client, with nothing to start separately.
#
# The file is Cursor-compatible: {"mcpServers": {"name": {"command": ..., "args": []}}}
#
# llm.cors_origins goes with it. Declaring MCP servers makes llama-server limit
# CORS to localhost for security, which locks out a browser on any other
# machine, so the real origin has to be named.
#
# llm.think controls reasoning models. Left on, a model like Qwen3.6 emits its
# whole thinking process before answering: the reply arrives in
# reasoning_content and `content` stays empty until it is done, which burns
# hundreds of tokens on small tasks and shows as an EMPTY REPLY in any client
# that reads only `content`. Off is the right default for a daily driver;
# turn it on for hard questions.
#
# The server speaks the OpenAI API, so any harness that can be pointed at a
# custom base URL drives it -- the editor on another machine, or an agent here.

# Every setting is looked up per profile first, then as a plain llm.* default.
# That way host, port, keyfile and the MCP config are written once and shared,
# while model, ctx and alias vary per profile -- and adding a profile is a
# config edit, not a code change.
_profile() { local v; v=$(cfg_text llm.profile); echo "${v:-default}"; }
_p() {
    local v
    v=$(cfg_text "llm.profile.$(_profile).$1")
    [[ -n $v ]] || v=$(cfg_text "llm.$1")
    # The config is read with grep, so a leading ~ arrives as a literal and any
    # path written that way would fail every -f test. Expand it here rather than
    # requiring absolute paths, because ~ is what people write.
    [[ $v == "~/"* ]] && v="$HOME/${v#\~/}"
    echo "$v"
}

_model()   { _p model; }
_host()    { local v; v=$(_p host); echo "${v:-127.0.0.1}"; }
_port()    { local v; v=$(_p port); echo "${v:-8080}"; }
_ctx()     { local v; v=$(_p ctx);  echo "${v:-8192}"; }
_keyfile() { _p keyfile; }
_think()   { local v; v=$(_p think); echo "${v:-0}"; }
_alias()   { local v; v=$(_p alias); echo "${v:-local}"; }
_mcpcfg()  { _p mcp_config; }
_cors()    { _p cors_origins; }
_parallel() { local v; v=$(_p parallel); echo "${v:-1}"; }
# q8_0 is the default because it was the hardcoded value before these became
# configurable, and no existing profile should change behaviour silently.
# Which llama-server binary, and which device it should use.
#
# Defaults to the locally built Vulkan server rather than the distro's ROCm one,
# because Vulkan measured faster on this card at every point tested, on real
# 600-token generations at ctx 81920, q8_0 KV, MTP n-max 2:
#
#                     MTP off   MTP on    max ctx
#     ROCm   307 W      26.9      44.1     122880
#     ROCm   221 W      25.0      41.3
#     Vulkan 307 W      37.6      57.8    >=163840
#     Vulkan 221 W      38.1      58.4
#
# Two things stand out. Vulkan is 31% faster than ROCm with MTP on, and it is
# indifferent to the power cap -- 221 W costs it nothing, while ROCm loses 6-7%
# -- so the quiet profile is free on Vulkan. It also avoids ROCm's
# hipGraphExecUpdate crash entirely, since no HIP is linked into that build,
# which is why GGML_CUDA_DISABLE_GRAPHS is no longer needed.
#
# The ROCm server is still installed at /usr/bin/llama-server; setting
# llm.bin and llm.device back to it is the whole rollback.
_bin() { local v; v=$(_p bin); echo "${v:-$HOME/opt/llama-vulkan/bin/llama-server}"; }
_dev() { local v; v=$(_p device); echo "${v:-Vulkan0}"; }
_ctk() { local v; v=$(_p cache_type_k); echo "${v:-q8_0}"; }
_ctv() { local v; v=$(_p cache_type_v); echo "${v:-q8_0}"; }

t_status() { [[ $(systemctl --user is-active "$_unit" 2>/dev/null) == active ]] && echo on || echo off; }

# Free VRAM in MiB, or nothing when there is no discrete card to ask.
_vram_free_mb() {
    local card; card=$(vc_gpu_card) || return 1
    [[ -r $card/mem_info_vram_total && -r $card/mem_info_vram_used ]] || return 1
    echo $(( ( $(cat "$card/mem_info_vram_total") - $(cat "$card/mem_info_vram_used") ) / 1048576 ))
}

# Refuse a profile that cannot fit rather than letting the driver decide.
#
# Weights and KV cache are both allocated up front, so the requirement is known
# before anything loads -- but it is not derivable from the file size, because
# the KV cache depends on context and the model's layer geometry. So it is a
# measured number per profile (vram_mb), and unset means no check.
#
# The failure this prevents is specific: a profile sized for headless mode
# started while the desktop still holds its gigabyte leaves the card with a
# hundred megabytes spare, and the next thing that wants GPU memory -- a browser
# tab, the compositor resizing something -- has nowhere to get it.
_vram_check() {
    local need free
    need=$(_p vram_mb); [[ -n $need ]] || return 0
    free=$(_vram_free_mb) || return 0
    (( free >= need )) && return 0
    printf 'needs %s MiB free, %s MiB available' "$need" "$free"
    return 1
}

t_on() {
    local m host port ctx key i _mcp _co
    m=$(_model)
    # rc 2 means "not configured", which the daemon reports as unavailable
    # rather than as a failure -- there is nothing to retry.
    [[ -n $m && -f $m ]] || return 2
    command -v llama-server >/dev/null 2>&1 || return 2

    local short
    if ! short=$(_vram_check); then
        printf '%s: %s -- switch to headless or pick a smaller profile' "$(_profile)" "$short"
        return 1
    fi

    host=$(_host); port=$(_port); ctx=$(_ctx); key=$(_keyfile)

    local -a args=(
        -m "$m" --host "$host" --port "$port"
        # --jinja makes the server use the chat template embedded in the GGUF.
        # Without it tool calls are never emitted in a form a harness can parse,
        # which is the difference between an agent and a chatbot.
        --jinja
        # -fa is not optional here: quantising the KV cache requires flash
        # attention, and the server refuses to start without it. It takes a
        # value since 0.4.1 -- a bare -fa swallows the next argument and the
        # server dies with "unknown value for --flash-attn: '-ctk'".
        # cache_type_k/cache_type_v are config because the KV cache, not the
        # weights, is what decides how much context fits. This model carries
        # 4 KV heads x 256+256 across 64 attention layers = 128 Ki elements per
        # token, so one token costs 136 KiB at q8_0, 96 KiB at q5_1 and 72 KiB
        # at q4_0. A 200k context is therefore 26 GB, 18 GB or 14 GB of cache --
        # the difference between fitting beside the weights and not.
        -fa on -ctk "$(_ctk)" -ctv "$(_ctv)"
        # -dev is not optional on this machine: both backends also enumerate the
        # 9700X iGPU as a second device, and an auto choice can split layers
        # across two very different ones.
        -dev "$(_dev)"
        -ngl 999 -c "$ctx"
        # Without an alias the model id is the full path on disk, which is what
        # a client has to type as the model name.
        --alias "$(_alias)"
        --parallel "$(_parallel)"
    )
    # --parallel alone divides the context between slots, so two slots on a 64k
    # context leave each client 32k. --kv-unified puts every sequence in one
    # shared buffer instead, which is what makes concurrent requests -- an agent
    # running sub-agents, say -- affordable rather than a halving of context.
    [[ $(_parallel) -gt 1 && $(_p kv_unified) != 0 ]] && args+=(--kv-unified)

    # Sampling. Only passed when configured, so anything left unset keeps
    # llama-server's own default rather than one invented here -- but note those
    # defaults (temp 0.8, top-k 40, min-p 0.05) are not what Qwen recommends, so
    # for a model that specifies values it is worth setting them.
    local v
    v=$(_p temp);             [[ -n $v ]] && args+=(--temp "$v")
    v=$(_p top_p);            [[ -n $v ]] && args+=(--top-p "$v")
    v=$(_p top_k);            [[ -n $v ]] && args+=(--top-k "$v")
    v=$(_p min_p);            [[ -n $v ]] && args+=(--min-p "$v")
    v=$(_p presence_penalty); [[ -n $v ]] && args+=(--presence-penalty "$v")
    v=$(_p n_predict);        [[ -n $v ]] && args+=(--n-predict "$v")
    # Host-side cache of evicted prompts. An agent loop resends a growing
    # conversation every turn, so keeping old prefixes around turns a full
    # reprocess into a cache hit.
    v=$(_p cache_ram);        [[ -n $v ]] && args+=(--cache-ram "$v")

    # Speculative decoding. draft-mtp uses the multi-token-prediction head that
    # an "-mtp" GGUF carries, drafting against the target model itself -- the
    # server logs "creating MTP draft context against the target model", so no
    # separate draft file is involved and spec_draft_model stays unset for it.
    #
    # Measured on this card, Qwen3.8-27B GSQ-RCO IQ3_S, 600-token generations:
    #   off        26.9 tok/s at ctx 122880
    #   n-max 2    44.1 tok/s at ctx  81920   <- chosen
    #   n-max 3    39.7 tok/s at ctx  65536
    #   n-max 4    35.4 tok/s at ctx  65536
    #   n-max 6    does not fit
    # Deeper drafts are monotonically slower: more tokens are drafted than get
    # accepted, so the extra forward passes are wasted. 2 is the optimum here.
    #
    # It is not free: the draft context and its compute buffers take VRAM out of
    # the KV cache, which is what drops the usable context from 122880 to 81920.
    #
    # 81920 and not 86016: 86016 starts and listens, then ABORTS on the first
    # real request with VRAM at 15.89 of 15.92 GB. Bisecting on "does it start"
    # overshoots -- the compute buffers for an actual decode are allocated
    # later than the KV cache, so a context can pass startup and still be
    # unusable. Any future ceiling hunt has to generate, not just boot.
    v=$(_p spec_type);        [[ -n $v ]] && args+=(--spec-type "$v")
    v=$(_p spec_draft_n_max); [[ -n $v ]] && args+=(--spec-draft-n-max "$v")
    v=$(_p spec_draft_model); [[ -n $v ]] && args+=(--spec-draft-model "$v")
    # A hard ceiling on thinking tokens, independent of how hard the model wants
    # to think. Without it a reasoning model can spend an entire reply budget
    # deliberating and return nothing.
    v=$(_p reasoning_budget); [[ -n $v ]] && args+=(--reasoning-budget "$v")
    [[ -n $key && -f $key ]] && args+=(--api-key-file "$key")

    # Chat-template knobs, assembled together because they share one flag.
    #
    # Qwen3.8 does not offer thinking as on/off: its template takes a
    # reasoning_effort of low, medium or xhigh, and defaults to xhigh -- which
    # deliberates at length before every answer. For an agent loop that is the
    # difference between a usable assistant and one that spends its reply budget
    # thinking. preserve_thinking=false keeps earlier turns' reasoning out of the
    # context that gets resent, which matters most in exactly the long sessions
    # where the model is being useful.
    local -a ctk=()
    if [[ $(_think) == 1 ]]; then
        v=$(_p reasoning_effort); [[ -n $v ]] && ctk+=("\"reasoning_effort\":\"$v\"")
        [[ $(_p reasoning_preserve) == 1 ]] || ctk+=('"preserve_thinking":false')
    else
        ctk+=('"enable_thinking":false')
    fi
    (( ${#ctk[@]} )) && args+=(--chat-template-kwargs "{$(IFS=,; printf '%s' "${ctk[*]}")}")
    _mcp=$(_mcpcfg)
    if [[ -n $_mcp && -f $_mcp ]]; then
        args+=(--mcp-servers-config "$_mcp")
        _co=$(_cors); [[ -z $_co ]] && _co="http://$host:$port"
        args+=(--cors-origins "$_co")
    fi

    vc_progress "loading $(basename "$m")"
    systemctl --user reset-failed "$_unit" >/dev/null 2>&1
    # GGML_CUDA_DISABLE_GRAPHS turns off ggml's HIP graph capture. On 2026-10-06
    # llama-server took a SIGSEGV inside the ROCm runtime after half an hour of
    # serving an agent harness: ggml_cuda_graph_evaluate_and_capture ->
    # hipGraphExecUpdate -> amd::roc::VirtualGPU::submitKernelInternal, i.e. the
    # driver crashed re-capturing the graph, not llama.cpp. Agent traffic is what
    # provokes it -- long repeated decodes with changing batch shapes across
    # slots mean the graph is rebuilt constantly. Costs a few percent throughput
    # and removes the whole failure mode; drop it if ROCm fixes the path.
    # The HIP variables are set only for a ROCm device. They do nothing on the
    # Vulkan build -- no HIP is linked -- and leaving them unconditional would
    # imply this still runs on ROCm.
    local -a envs=()
    if [[ $(_dev) == ROCm* ]]; then
        envs+=(--setenv=HIP_VISIBLE_DEVICES=0 --setenv=GGML_CUDA_DISABLE_GRAPHS=1)
    fi
    local bin; bin=$(_bin)
    [[ -x $bin ]] || { printf 'llama-server not executable: %s' "$bin"; return 2; }
    # Memory guard. On 2026-10-12 this server was killed by the *global*
    # oom-killer, taking the machine's memory with it rather than just dying.
    # Two reasons it escalated that far:
    #   - swap here is /dev/zram0, i.e. compressed RAM. Quantized weights and
    #     KV pages are high-entropy, so lzo-rle got 1.04:1 -- zram stored
    #     7.7G of swap by eating 7.4G of real RAM, which fed the pressure it
    #     was supposed to relieve. MemorySwapMax=0 keeps this unit out of it.
    #   - amdgpu pins ~3.5G of host RAM as GTT once VRAM is full, and that is
    #     not reclaimable, so the usable budget is ~27G, not 31G.
    # MemoryMax turns any future overshoot into a dead service instead of a
    # dead desktop. Raise it if cache_ram grows past ~20G.
    systemd-run --user --unit="$_unit" --description="vibecontrol: local LLM server" \
        -p MemorySwapMax=0 -p MemoryMax=24G \
        "${envs[@]}" \
        "$bin" "${args[@]}" >/dev/null 2>&1 || return 1

    # systemd returns the moment it forks, which is long before the weights are
    # on the card. Wait for the server to answer instead, so a preset that turns
    # this on does not report done while it is still loading. No signal exists
    # for "http server is ready", so this one has to ask.
    for i in $(seq 1 100); do
        curl -sf --max-time 2 "http://$host:$port/health" >/dev/null 2>&1 && {
            vc_progress "serving on $host:$port"; return 0; }
        [[ $(systemctl --user is-active "$_unit" 2>/dev/null) == active ]] || return 1
        sleep 1
    done
    return 1
}

# Stopping is not instant and it is worth showing: the unit takes a moment to
# come down, and the driver hands back the VRAM some time after the process has
# actually gone. Reporting "off" while the card still looks full is how the next
# thing to want the GPU fails for no visible reason.
t_off() {
    local i card; card=$(vc_gpu_card)
    vc_progress "stopping the server"
    systemctl --user stop "$_unit" >/dev/null 2>&1
    [[ -r $card/mem_info_vram_used ]] || return 0
    for i in $(seq 1 20); do
        (( $(cat "$card/mem_info_vram_used") < 1073741824 )) && return 0
        [[ $i == 1 ]] && vc_progress "releasing the GPU"
        sleep 1
    done
    return 0
}

t_force() {
    local want="$1"
    [[ $want == on ]] && { t_on; return; }
    vc_progress "killing the server"
    systemctl --user kill --signal=KILL "$_unit" >/dev/null 2>&1
    systemctl --user stop "$_unit" >/dev/null 2>&1
    systemctl --user reset-failed "$_unit" >/dev/null 2>&1
}
