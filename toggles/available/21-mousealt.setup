#!/usr/bin/env bash
# Writes the input-remapper preset that the mousealt feature switches on.
#
# The preset is generated rather than shipped because the button, the key it
# should produce and the device name are all config, and because it needs an
# origin_hash -- input-remapper's identifier for which sub-device an event comes
# from. That hash is taken from any preset already present for the same device,
# which is more reliable than asking someone to find it.
set -uo pipefail
CFG="${VC_CFG_DIR:-$HOME/.config/vibecontrol}/config"
IR="$HOME/.config/input-remapper-2"

cfgv() { grep -E "^$1=" "$CFG" 2>/dev/null | tail -1 | cut -d= -f2-; }
cfg_default() {
    grep -qE "^$1=" "$CFG" 2>/dev/null && return 0
    mkdir -p "$(dirname "$CFG")"; printf '%s=%s\n' "$1" "$2" >>"$CFG"; echo "config: $1=$2"
}
# Earlier versions of this feature stored a single device name and a single USB
# id, which covered the mouse only while it was on the receiver. Upgrade those
# exact old defaults in place; anything the user has customised is left alone.
cfg_upgrade() {
    local key=$1 from=$2 to=$3
    [[ $(cfgv "$key") == "$from" ]] || return 0
    sed -i "s|^$key=.*|$key=$to|" "$CFG" && echo "config: $key upgraded to $to"
}
# Splits a comma-separated config value into one item per line.
cfg_list() {
    local v; v=$(cfgv "$1"); v="${v:-$2}"
    local IFS=','; local x
    for x in $v; do
        x="${x#"${x%%[![:space:]]*}"}"; x="${x%"${x##*[![:space:]]}"}"
        [[ -n $x ]] && printf '%s\n' "$x"
    done
}

case "${1:-}" in
phases) printf 'check\ninstall\nuninstall\nroot-install\nroot-uninstall\n' ;;
check)
    command -v input-remapper-control >/dev/null 2>&1 || { echo "input-remapper not installed"; exit 1; }
    [[ $(systemctl is-active input-remapper 2>/dev/null) == active ]] \
        || { echo "input-remapper service not running"; exit 1; }
    # The real readiness test. input-remapper's client calls capabilities() on
    # each device to classify it, which means opening it -- so a device it cannot
    # read is invisible, and start fails with "unknown ... or you are missing
    # permissions". Input nodes are root:input; only devices tagged uaccess get
    # an ACL for the logged-in user.
    #
    # ANY of the listed identities being visible is enough, not all of them: the
    # wired identity only exists while the charging cable is in. Failing on the
    # absent one would make the check depend on where the cable happens to be.
    visible=$(input-remapper-control --list-devices 2>/dev/null)
    seen=0; missing=()
    while IFS= read -r dev; do
        if grep -qxF "$dev" <<<"$visible"; then seen=$((seen + 1)); else missing+=("$dev"); fi
    done < <(cfg_list mousealt.device "Logitech G502")
    (( seen )) || {
        echo "none of the configured devices are visible to input-remapper"
        echo "  (needs the uaccess rule; run: sudo ./install.sh --root)"
        exit 1
    }
    # Invisible means either "not plugged in" or "no uaccess rule yet", and the
    # two are indistinguishable from here, so the note says both.
    (( ${#missing[@]} )) && printf 'note: not visible to input-remapper (not connected, or no uaccess rule yet): %s\n' \
        "${missing[*]}"
    ;;
install)
    cfg_default mousealt.device "Logitech G502,Logitech G502 LIGHTSPEED Wireless Gaming Mouse"
    cfg_upgrade mousealt.device "Logitech G502" \
        "Logitech G502,Logitech G502 LIGHTSPEED Wireless Gaming Mouse"
    cfg_default mousealt.preset vibecontrol-mousealt
    # BTN_SIDE is the back button on a stock G502. If the mouse's onboard memory
    # has been programmed the button may send something else entirely, which is
    # why this is a config key and not a constant -- see the feature's notes.
    cfg_default mousealt.button BTN_SIDE
    cfg_default mousealt.output KEY_LEFTALT
    # USB id the uaccess rule targets, so the root phase is not hardcoded either.
    # Both USB ids: the receiver, and the mouse's own interface when cabled.
    cfg_default mousealt.usb_id 046d:c539,046d:c08d
    cfg_upgrade mousealt.usb_id 046d:c539 046d:c08d,046d:c539
    preset=$(cfgv mousealt.preset)
    btn=$(cfgv mousealt.button); out=$(cfgv mousealt.output)
    mapfile -t devs < <(cfg_list mousealt.device "Logitech G502")
    python3 - "$IR" "$preset" "$btn" "$out" "${devs[@]}" <<'PY'
import glob, json, os, sys
ir, preset, btn, out = sys.argv[1:5]
devices = sys.argv[5:]
try:
    from evdev import ecodes
except ImportError:
    sys.exit("python3-evdev is needed to turn a button name into a code")
code = ecodes.ecodes.get(btn)
if code is None:
    sys.exit("unknown button name: %s" % btn)


def origin_hash(d):
    # Reuse the origin_hash from a sibling preset IN THE SAME DIRECTORY: it
    # identifies the sub-device the events arrive on, so it is specific to one
    # device identity. Copying it between the wired and wireless directories
    # would point at the wrong node and the mapping would never fire.
    for f in sorted(glob.glob(os.path.join(d, "*.json"))):
        if os.path.basename(f) == preset + ".json":
            continue
        try:
            for m in json.load(open(f)):
                for c in m.get("input_combination", []):
                    if c.get("origin_hash"):
                        return c["origin_hash"]
        except Exception:
            continue
    return None


for dev in devices:
    d = os.path.join(ir, "presets", dev)
    os.makedirs(d, exist_ok=True)
    origin = origin_hash(d)
    combo = {"type": 1, "code": code}
    if origin:
        combo["origin_hash"] = origin
    path = os.path.join(d, preset + ".json")
    json.dump([{
        "input_combination": [combo],
        "target_uinput": "keyboard",
        # A bare key name holds that key for as long as the button is held,
        # which is what a modifier has to do; a macro would fire once and
        # release.
        "output_symbol": out,
        "name": "vibecontrol: %s as %s" % (btn, out),
        "mapping_type": "key_macro",
    }], open(path, "w"), indent=4)
    print("wrote %s (%s code %d -> %s, origin_hash %s)"
          % (path, btn, code, out, origin or "none found"))
PY
    : ;;
root-install)
    # uaccess rather than adding the user to the input group. The group grants
    # read access to every input device, keyboards included, which is a
    # keylogging surface; uaccess is logind giving the *active session* user an
    # ACL on this one device, and it goes away with the session.
    f=/etc/udev/rules.d/70-vibecontrol-mousealt.rules
    {
      echo '# Installed by vibecontrol (toggles/available/21-mousealt.setup).'
      echo '# Lets the logged-in user'"'"'s input-remapper client see these devices: it'
      echo '# classifies devices by opening them, so one it cannot read does not exist'
      echo '# as far as it is concerned. Scoped to specific USB ids, not the input group.'
      echo '# One line per id: the mouse enumerates differently on the receiver than it'
      echo '# does on the charging cable, and the feature has to cover both.'
      while IFS= read -r usb; do
          printf 'SUBSYSTEM=="input", ATTRS{idVendor}=="%s", ATTRS{idProduct}=="%s", TAG+="uaccess"\n' \
              "${usb%%:*}" "${usb##*:}"
      done < <(cfg_list mousealt.usb_id 046d:c539)
    } >"$f"
    chmod 0644 "$f"
    udevadm control --reload-rules 2>/dev/null || true
    # Re-runs the add event so logind applies the ACL now, not at next replug.
    udevadm trigger --subsystem-match=input --action=add 2>/dev/null || true
    echo "installed $f for $(cfg_list mousealt.usb_id 046d:c539 | paste -sd' ')"
    : ;;
root-uninstall)
    f=/etc/udev/rules.d/70-vibecontrol-mousealt.rules
    rm -f "$f" && echo "removed $f"
    udevadm control --reload-rules 2>/dev/null || true
    : ;;
uninstall)
    preset=$(cfgv mousealt.preset); preset="${preset:-vibecontrol-mousealt}"
    gone=0
    while IFS= read -r dev; do
        f="$IR/presets/$dev/$preset.json"
        [[ -f $f ]] && { rm -f "$f"; echo "removed $f"; gone=$((gone + 1)); }
    done < <(cfg_list mousealt.device "Logitech G502")
    (( gone )) || echo "no preset to remove"
    : ;;
*) echo "usage: $0 {phases|check|install|uninstall}" >&2; exit 2 ;;
esac
