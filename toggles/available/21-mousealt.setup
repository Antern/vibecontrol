#!/usr/bin/env bash
# Writes the input-remapper preset that the mousealt feature switches on.
#
# The preset is generated rather than shipped because the button, the key it
# should produce and the device name are all config, and because it needs an
# origin_hash -- input-remapper's identifier for which sub-device an event comes
# from. That hash is taken from any preset already present for the same device,
# which is more reliable than asking someone to find it.
set -uo pipefail
CFG="${VC_CFG_DIR:-$HOME/.config/vibecontrol}/config"
IR="$HOME/.config/input-remapper-2"

cfgv() { grep -E "^$1=" "$CFG" 2>/dev/null | tail -1 | cut -d= -f2-; }
cfg_default() {
    grep -qE "^$1=" "$CFG" 2>/dev/null && return 0
    mkdir -p "$(dirname "$CFG")"; printf '%s=%s\n' "$1" "$2" >>"$CFG"; echo "config: $1=$2"
}

case "${1:-}" in
phases) printf 'check\ninstall\nuninstall\nroot-install\nroot-uninstall\n' ;;
check)
    command -v input-remapper-control >/dev/null 2>&1 || { echo "input-remapper not installed"; exit 1; }
    [[ $(systemctl is-active input-remapper 2>/dev/null) == active ]] \
        || { echo "input-remapper service not running"; exit 1; }
    # The real readiness test. input-remapper's client calls capabilities() on
    # each device to classify it, which means opening it -- so a device it cannot
    # read is invisible, and start fails with "unknown ... or you are missing
    # permissions". Input nodes are root:input; only devices tagged uaccess get
    # an ACL for the logged-in user.
    dev=$(cfgv mousealt.device); dev="${dev:-Logitech G502}"
    input-remapper-control --list-devices 2>/dev/null | grep -qxF "$dev" \
        || { echo "$dev is not visible to input-remapper (needs the uaccess rule)"; exit 1; }
    ;;
install)
    cfg_default mousealt.device "Logitech G502"
    cfg_default mousealt.preset vibecontrol-mousealt
    # BTN_SIDE is the back button on a stock G502. If the mouse's onboard memory
    # has been programmed the button may send something else entirely, which is
    # why this is a config key and not a constant -- see the feature's notes.
    cfg_default mousealt.button BTN_SIDE
    cfg_default mousealt.output KEY_LEFTALT
    # USB id the uaccess rule targets, so the root phase is not hardcoded either.
    cfg_default mousealt.usb_id 046d:c539
    dev=$(cfgv mousealt.device); preset=$(cfgv mousealt.preset)
    btn=$(cfgv mousealt.button); out=$(cfgv mousealt.output)
    python3 - "$IR" "$dev" "$preset" "$btn" "$out" <<'PY'
import glob, json, os, sys
ir, dev, preset, btn, out = sys.argv[1:6]
try:
    from evdev import ecodes
except ImportError:
    sys.exit("python3-evdev is needed to turn a button name into a code")
code = ecodes.ecodes.get(btn)
if code is None:
    sys.exit("unknown button name: %s" % btn)
d = os.path.join(ir, "presets", dev)
os.makedirs(d, exist_ok=True)
# Reuse the origin_hash from a sibling preset: it identifies the sub-device the
# events arrive on, and getting it wrong means the mapping never fires.
origin = None
for f in glob.glob(os.path.join(d, "*.json")):
    if os.path.basename(f) == preset + ".json":
        continue
    try:
        for m in json.load(open(f)):
            for c in m.get("input_combination", []):
                if c.get("origin_hash"):
                    origin = c["origin_hash"]; raise StopIteration
    except StopIteration:
        break
    except Exception:
        continue
combo = {"type": 1, "code": code}
if origin:
    combo["origin_hash"] = origin
path = os.path.join(d, preset + ".json")
json.dump([{
    "input_combination": [combo],
    "target_uinput": "keyboard",
    # A bare key name holds that key for as long as the button is held, which is
    # what a modifier has to do; a macro would fire once and release.
    "output_symbol": out,
    "name": "vibecontrol: %s as %s" % (btn, out),
    "mapping_type": "key_macro",
}], open(path, "w"), indent=4)
print("wrote %s (%s code %d -> %s, origin_hash %s)"
      % (path, btn, code, out, origin or "none found"))
PY
    : ;;
root-install)
    # uaccess rather than adding the user to the input group. The group grants
    # read access to every input device, keyboards included, which is a
    # keylogging surface; uaccess is logind giving the *active session* user an
    # ACL on this one device, and it goes away with the session.
    usb=$(cfgv mousealt.usb_id); usb="${usb:-046d:c539}"
    vid="${usb%%:*}"; pid="${usb##*:}"
    f=/etc/udev/rules.d/70-vibecontrol-mousealt.rules
    {
      echo '# Installed by vibecontrol (toggles/available/24-mousealt.setup).'
      echo '# Lets the logged-in user'"'"'s input-remapper client see this device: it'
      echo '# classifies devices by opening them, so one it cannot read does not exist'
      echo '# as far as it is concerned. Scoped to a single USB id, not the input group.'
      printf 'SUBSYSTEM=="input", ATTRS{idVendor}=="%s", ATTRS{idProduct}=="%s", TAG+="uaccess"\n' "$vid" "$pid"
    } >"$f"
    chmod 0644 "$f"
    udevadm control --reload-rules 2>/dev/null || true
    # Re-runs the add event so logind applies the ACL now, not at next replug.
    udevadm trigger --subsystem-match=input --action=add 2>/dev/null || true
    echo "installed $f for $vid:$pid"
    : ;;
root-uninstall)
    f=/etc/udev/rules.d/70-vibecontrol-mousealt.rules
    rm -f "$f" && echo "removed $f"
    udevadm control --reload-rules 2>/dev/null || true
    : ;;
uninstall)
    dev=$(cfgv mousealt.device); preset=$(cfgv mousealt.preset)
    f="$IR/presets/$dev/${preset:-vibecontrol-mousealt}.json"
    [[ -f $f ]] && { rm -f "$f"; echo "removed $f"; } || echo "no preset to remove"
    : ;;
*) echo "usage: $0 {phases|check|install|uninstall}" >&2; exit 2 ;;
esac
