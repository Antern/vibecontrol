[Desktop Entry]
Type=Application
Version=1.4
Name=vibecontrol
GenericName=Machine Modes
Comment=Switch machine modes: desktop, headless server, remote play, local LLM
Exec=konsole --separate --hide-menubar --hide-tabbar --desktopfile vibecontrol -p TerminalColumns=88 -p TerminalRows=26 -e vibecontrol
Icon=dashboard-show
Terminal=false
Categories=Settings;
Keywords=vibecontrol;vibecontrol;toggle;hotspot;server;macro;airpods;
StartupNotify=true
# X11 fallback; on Wayland the app-id from --desktopfile is what matches.
StartupWMClass=vibecontrol
SingleMainWindow=true
